{
  "name": "gabon-sejours",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Base de données D1 créée automatiquement au premier déploiement (wrangler >= 4.45)
  "d1_databases": [
    { "binding": "DB", "database_name": "gabon-sejours-db" }
  ]
}
